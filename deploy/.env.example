# Local stack (no VPS). Copy to deploy/.env
#   cp deploy/.env.example deploy/.env

PROSTOCK_PORT=8000
N8N_PORT=5678
OLLAMA_PORT=11434

# n8n is HTTP on localhost. Open http://127.0.0.1:5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://127.0.0.1:5678/
N8N_SECURE_COOKIE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin
N8N_ENCRYPTION_KEY=local-dev-only-change-later

# n8n → FastAPI on the same compose network
PROSTOCK_URL=http://prostock:8000

# Cloud models via API key must call ollama.com (local :11434 cloud proxy needs `ollama signin`).
OLLAMA_MODEL=nemotron-3-ultra:cloud
OLLAMA_KEEP_ALIVE=24h
# Required for :cloud models. Create at https://ollama.com/settings/keys
# Or run: ollama signin   then ollama pull nemotron-3-ultra:cloud
OLLAMA_API_KEY=
